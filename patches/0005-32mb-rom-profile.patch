From: FIRERED project
Subject: [PATCH] Add maximum-standard 32 MiB ROM build profile

Reference target: pret/pokefirered
Reference snapshot: c75f352304d529f6ba92d4f74b9cf8b5c3810788

The retail matching build is 16 MiB and remains unchanged by default.

The GBA's ordinary directly-addressable Game Pak ROM image is at most 32 MiB:
    0x08000000 .. 0x09FFFFFF

The 0x0A000000 and 0x0C000000 ROM regions are alternate wait-state images of
the same cartridge ROM, not additional independent capacity.

The FireRed linker already declares:
    ROM (rx) : ORIGIN = 0x8000000, LENGTH = 32M

Therefore FIRERED_EXPANDED=1 selects the maximum standard-hardware-compatible
ROM image size, padding through 0x0A000000 (32 MiB).

--- a/Makefile
+++ b/Makefile
@@
 ROM := poke$(BUILD_NAME).gba
 OBJ_DIR := $(BUILD_DIR)/$(BUILD_NAME)
 
 ELF := $(ROM:.gba=.elf)
 MAP := $(ROM:.gba=.map)
 SYM := $(ROM:.gba=.sym)
+
+# Retail matching profile: 16 MiB.
+# FIRERED expanded profile: maximum standard GBA ROM image, 32 MiB.
+FIRERED_EXPANDED ?= 0
+ifeq ($(FIRERED_EXPANDED),1)
+ROM_PAD_TO := 0x0A000000
+else
+ROM_PAD_TO := 0x09000000
+endif
@@
 # Builds the rom from the elf file
 $(ROM): $(ELF)
-	$(OBJCOPY) -O binary --gap-fill 0xFF --pad-to 0x9000000 $< $@
+	$(OBJCOPY) -O binary --gap-fill 0xFF --pad-to $(ROM_PAD_TO) $< $@
