@@
-    for (i = 0; i < MAX_LEVEL_UP_MOVES; i++)
+    for (i = 0; i < MAX_LEVEL_UP_MOVES * LEVEL_UP_MOVE_ENTRY_WORDS; i += LEVEL_UP_MOVE_ENTRY_WORDS)
     {
+        u16 move;
         u16 moveLevel;
 
