From: FIRERED project
Subject: [PATCH 9] Widen global ability IDs to 16 bits

Reference target: pret/pokefirered
Reference snapshot: c75f352304d529f6ba92d4f74b9cf8b5c3810788
Modern reference: rh-hideout/pokeemerald-expansion@75b806a3ab57a81ff1eb6179288981f0b3cc3050

Modern ability IDs already exceed 255, so FireRed's u8 ability paths are a
present blocker for the Generation-10 profile.

This patch widens the global ability ID path to u16 while deliberately leaving
the retail BoxPokemon abilityNum:1 persistence unchanged. Hidden-ability
persistence is handled by a later per-mon metadata patch.

Important compatibility detail: CONTROLLER_CHOOSEPOKEMON already transfers
8 bytes while only 7 were initialized. Use the previously-unused byte 7 for
the high byte of the ability ID. Packet length therefore stays unchanged.

BattlePokemon also stays the same size: the old byte at 0x23 was unused, so
ability grows from u8 to u16 and type1/type2 move one byte later inside the
same four-byte region.

--- a/include/constants/global.h
+++ b/include/constants/global.h
@@
 #define TRAINER_ID_LENGTH 4
 #define MAX_MON_MOVES 4
+#define NUM_ABILITY_SLOTS 3
 #define PARTY_SIZE 6
 #define MULTI_PARTY_SIZE (PARTY_SIZE / 2)

--- a/include/pokemon.h
+++ b/include/pokemon.h
@@
- /* 0x16 */ u8 abilities[2];
- /* 0x18 */ u8 safariZoneFleeRate;
- /* 0x19 */ u8 bodyColor : 7;
+ /* expanded */ u16 abilities[NUM_ABILITY_SLOTS];
+ u8 safariZoneFleeRate;
+ u8 bodyColor : 7;
@@
-    /*0x20*/ u8 ability;
-    /*0x21*/ u8 type1;
-    /*0x22*/ u8 type2;
-    /*0x23*/ u8 unknown;
+    /*0x20*/ u16 ability;
+    /*0x22*/ u8 type1;
+    /*0x23*/ u8 type2;
@@
-u8 GetAbilityBySpecies(u16 species, bool8 abilityNum);
-u8 GetMonAbility(struct Pokemon *mon);
+u16 GetAbilityBySpecies(u16 species, u8 abilityNum);
+u16 GetMonAbility(struct Pokemon *mon);

--- a/include/battle.h
+++ b/include/battle.h
@@
 struct BattleHistory
 {
     /*0x00*/ u16 usedMoves[2][8]; // 0xFFFF means move not used (confuse self hit, etc)
-    /*0x20*/ u8 abilities[MAX_BATTLERS_COUNT / 2];
-    /*0x22*/ u8 itemEffects[MAX_BATTLERS_COUNT / 2];
-    /*0x24*/ u16 trainerItems[MAX_BATTLERS_COUNT];
-    /*0x2C*/ u8 itemsNo;
+    /*0x20*/ u16 abilities[MAX_BATTLERS_COUNT / 2];
+    /*0x24*/ u8 itemEffects[MAX_BATTLERS_COUNT / 2];
+    /*0x26*/ u16 trainerItems[MAX_BATTLERS_COUNT];
+    /*0x2E*/ u8 itemsNo;
 };
@@
-    u8 abilityPreventingSwitchout;
+    u16 abilityPreventingSwitchout;
     u8 hpScale;
@@
-extern u8 gLastUsedAbility;
+extern u16 gLastUsedAbility;

--- a/include/battle_message.h
+++ b/include/battle_message.h
@@
 #define PREPARE_ABILITY_BUFFER(textVar, abilityId)                          \
 {                                                                           \
     textVar[0] = B_BUFF_PLACEHOLDER_BEGIN;                                  \
     textVar[1] = B_BUFF_ABILITY;                                            \
     textVar[2] = abilityId;                                                 \
-    textVar[3] = B_BUFF_EOS;                                                \
+    textVar[3] = (abilityId & 0xFF00) >> 8;                                 \
+    textVar[4] = B_BUFF_EOS;                                                \
 }
@@
 struct BattleMsgData
 {
     u16 currentMove;
     u16 originallyUsedMove;
     u16 lastItem;
-    u8 lastAbility;
+    u16 lastAbility;
     u8 scrActive;
     u8 bakScriptPartyIdx;
     u8 hpScale;
     u8 itemEffectBattler;
     u8 moveType;
-    u8 abilities[4];
+    u16 abilities[4];
     u8 textBuffs[3][0x10];
 };

