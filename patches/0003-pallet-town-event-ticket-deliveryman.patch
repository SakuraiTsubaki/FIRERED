+      "x": 8,
+      "y": 11,
+      "elevation": 3,
+      "movement_type": "MOVEMENT_TYPE_FACE_RIGHT",
+      "movement_range_x": 0,
+      "movement_range_y": 0,
+      "trainer_type": "TRAINER_TYPE_NONE",
+      "trainer_sight_or_berry_tree_id": "0",
+      "script": "PalletTown_EventScript_EventTicketDeliveryman",
+      "flag": "0"
+    },
     {
       "local_id": "LOCALID_PALLET_SIGN_LADY",

--- a/data/maps/PalletTown/scripts.inc
+++ b/data/maps/PalletTown/scripts.inc
@@
 .equ SIGN_LADY_READY, VAR_TEMP_2
+
+PalletTown_EventScript_EventTicketDeliveryman::
+	lock
+	faceplayer
+	message PalletTown_Text_EventDeliverymanChoose
+	waitmessage
+	multichoice 12, 5, MULTICHOICE_EVENT_TICKETS, FALSE
+	switch VAR_RESULT
+	case 0, PalletTown_EventScript_ChooseAuroraTicket
+	case 1, PalletTown_EventScript_ChooseMysticTicket
+	case 2, PalletTown_EventScript_ChooseBothTickets
+	case 3, PalletTown_EventScript_EventTicketCancel
+	case 127, PalletTown_EventScript_EventTicketCancel
+	end
+
+PalletTown_EventScript_ChooseAuroraTicket::
+	checkitem ITEM_AURORA_TICKET, 1
+	goto_if_eq VAR_RESULT, TRUE, PalletTown_EventScript_AlreadyHasAuroraTicket
+	checkitemspace ITEM_AURORA_TICKET, 1
+	goto_if_eq VAR_RESULT, FALSE, PalletTown_EventScript_EventTicketBagFull
+	giveitem ITEM_AURORA_TICKET
+	msgbox PalletTown_Text_EventDeliverymanAuroraDelivered
+	release
+	end
+
+PalletTown_EventScript_ChooseMysticTicket::
+	checkitem ITEM_MYSTIC_TICKET, 1
+	goto_if_eq VAR_RESULT, TRUE, PalletTown_EventScript_AlreadyHasMysticTicket
+	checkitemspace ITEM_MYSTIC_TICKET, 1
+	goto_if_eq VAR_RESULT, FALSE, PalletTown_EventScript_EventTicketBagFull
+	giveitem ITEM_MYSTIC_TICKET
+	msgbox PalletTown_Text_EventDeliverymanMysticDelivered
+	release
+	end
+
+PalletTown_EventScript_ChooseBothTickets::
+	checkitem ITEM_AURORA_TICKET, 1
+	goto_if_eq VAR_RESULT, FALSE, PalletTown_EventScript_ChooseBothNeedAurora
+	checkitem ITEM_MYSTIC_TICKET, 1
+	goto_if_eq VAR_RESULT, FALSE, PalletTown_EventScript_ChooseMysticTicket
+	goto PalletTown_EventScript_AlreadyHasBothTickets
+	end
+
+PalletTown_EventScript_ChooseBothNeedAurora::
+	checkitemspace ITEM_AURORA_TICKET, 1
+	goto_if_eq VAR_RESULT, FALSE, PalletTown_EventScript_EventTicketBagFull
+	giveitem ITEM_AURORA_TICKET
+	checkitem ITEM_MYSTIC_TICKET, 1
+	goto_if_eq VAR_RESULT, TRUE, PalletTown_EventScript_BothTicketsDelivered
+	checkitemspace ITEM_MYSTIC_TICKET, 1
+	goto_if_eq VAR_RESULT, FALSE, PalletTown_EventScript_EventTicketPartial
+	giveitem ITEM_MYSTIC_TICKET
+	goto PalletTown_EventScript_BothTicketsDelivered
+	end
+
+PalletTown_EventScript_AlreadyHasAuroraTicket::
+	msgbox PalletTown_Text_EventDeliverymanAlreadyHasAurora
+	release
+	end
+
+PalletTown_EventScript_AlreadyHasMysticTicket::
+	msgbox PalletTown_Text_EventDeliverymanAlreadyHasMystic
+	release
+	end
+
+PalletTown_EventScript_AlreadyHasBothTickets::
+	msgbox PalletTown_Text_EventDeliverymanAlreadyHasBoth
+	release
+	end
+
+PalletTown_EventScript_BothTicketsDelivered::
+	msgbox PalletTown_Text_EventDeliverymanBothDelivered
+	release
+	end
+
+PalletTown_EventScript_EventTicketPartial::
+	msgbox PalletTown_Text_EventDeliverymanPartial
+	release
+	end
+
+PalletTown_EventScript_EventTicketBagFull::
+	msgbox PalletTown_Text_EventDeliverymanBagFull
+	release
+	end
+
+PalletTown_EventScript_EventTicketCancel::
+	release
+	end
+
+PalletTown_Text_EventDeliverymanChoose:
+	.string "I have special event tickets for you.\\p"
+	.string "Which would you like?$"
+
+PalletTown_Text_EventDeliverymanAuroraDelivered:
+	.string "Here is your AURORATICKET.\\p"
+	.string "Keep it until the proper ferry route opens.$"
+
+PalletTown_Text_EventDeliverymanMysticDelivered:
+	.string "Here is your MYSTICTICKET.\\p"
+	.string "Keep it until the proper ferry route opens.$"
+
+PalletTown_Text_EventDeliverymanBothDelivered:
+	.string "Here are both special tickets.\\p"
+	.string "Keep them until the proper ferry routes open.$"
+
+PalletTown_Text_EventDeliverymanAlreadyHasAurora:
+	.string "You already have an AURORATICKET.$"
+
+PalletTown_Text_EventDeliverymanAlreadyHasMystic:
+	.string "You already have a MYSTICTICKET.$"
+
+PalletTown_Text_EventDeliverymanAlreadyHasBoth:
+	.string "You already have both special tickets.$"
+
+PalletTown_Text_EventDeliverymanPartial:
+	.string "I delivered what would fit.\\p"
+	.string "Make some space, then speak to me again.$"
+
+PalletTown_Text_EventDeliverymanBagFull:
+	.string "Your KEY ITEMS POCKET has no room.\\p"
+	.string "Make some space, then speak to me again.$"
