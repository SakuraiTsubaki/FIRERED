From: FIRERED project
Subject: [PATCH 3/3] Add selectable event-ticket deliveryman to Pallet Town

Reference target: pret/pokefirered

This creates an always-available in-game replacement for limited external
distribution. The NPC exists from the beginning of the game and presents a
four-choice menu:

  1. AURORATICKET
  2. MYSTICTICKET
  3. BOTH
  4. CANCEL

Individual choices never duplicate a ticket already in the Key Items pocket.
BOTH gives only the missing ticket(s).

Ferry usability remains controlled by normal Seagallop story progression.
PATCH 1/3 makes possession of the ticket item the only event-island
entitlement check.

--- a/include/constants/menu.h
+++ b/include/constants/menu.h
@@
 #define MULTICHOICE_TRAINER_TOWER_MODE                         64
+#define MULTICHOICE_EVENT_TICKETS                              65
 
 #define MULTICHOICE_NONE                                      255

--- a/src/script_menu.c
+++ b/src/script_menu.c
@@
 static const struct MenuAction sMultichoiceList_TrainerTowerMode[] = {
     { gOtherText_Single },
     { gOtherText_Double },
     { gOtherText_Knockout },
     { gOtherText_Mixed },
     { gOtherText_Exit }
 };
+
+static const u8 sText_AuroraTicketChoice[] = _("AURORATICKET");
+static const u8 sText_MysticTicketChoice[] = _("MYSTICTICKET");
+static const u8 sText_BothTicketsChoice[] = _("BOTH");
+
+static const struct MenuAction sMultichoiceList_EventTickets[] = {
+    { sText_AuroraTicketChoice },
+    { sText_MysticTicketChoice },
+    { sText_BothTicketsChoice },
+    { gOtherText_Exit }
+};
@@
     [MULTICHOICE_JOIN_OR_LEAD]                               = MULTICHOICE(sMultichoiceList_JoinOrLead),
     [MULTICHOICE_TRAINER_TOWER_MODE]                         = MULTICHOICE(sMultichoiceList_TrainerTowerMode),
+    [MULTICHOICE_EVENT_TICKETS]                              = MULTICHOICE(sMultichoiceList_EventTickets),
 };

--- a/data/maps/PalletTown/map.json
+++ b/data/maps/PalletTown/map.json
@@
   "object_events": [
